{
  "name": "octate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "octate": "./bin/octate"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-wasm.cjs && chmod +x dist/cli.js",
    "copy:wasm": "node scripts/copy-wasm.cjs",
    "pack:check": "npm run build && npm pack --dry-run",
    "bench": "tsx scripts/bench.ts",
    "dev": "tsx watch src/cli.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --apply .",
    "prepare": "husky install"
  },
  "dependencies": {
    "@microsoft/sarif": "latest",
    "commander": "15.0.0",
    "fast-glob": "3.3.3",
    "ignore": "7.0.8",
    "ink": "7.1.1",
    "isomorphic-git": "1.41.9",
    "node-sarif-builder": "5.0.0",
    "p-limit": "7.3.2",
    "p-queue": "7.3.2",
    "picocolors": "1.1.1",
    "pino": "10.3.1",
    "react": "19.2.8",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.27.0",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@jest/globals": "^30.5.1",
    "@types/jest": "latest",
    "@types/node": "26.4.1",
    "@types/react": "^19.3.0",
    "husky": "latest",
    "jest": "30.5.1",
    "pino-pretty": "^13.1.3",
    "ts-jest": "29.4.12",
    "tsx": "latest",
    "typescript": "5.9.3"
  }
}
