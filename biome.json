{
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": "error",
      "style": "warn",
      "suspicious": "error",
      "style": {
        "noProcessEnv": "off",
        "noExcessiveClassesPerFile": "off",
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false
          }
        }
      },
      "correctness": {
        "noNodejsModules": "off",
        "noProcessGlobal": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "trailingCommas": "es5",
      "quoteStyle": "single"
    }
  },
  "files": {
    "ignoreUnknown": false,
    "experimentalScannerIgnores": ["dist/", "node_modules/", "coverage/", ".opencode/", ".planning/"]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}