{
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noProcessEnv": "off",
        "noExcessiveClassesPerFile": "off",
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false
          }
        }
      },
      "correctness": {
        "noNodejsModules": "off",
        "noProcessGlobal": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "trailingCommas": "es5",
      "quoteStyle": "single"
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*",
      "scripts/**/*",
      "test/**/*",
      "!test/fixtures/**/*",
      "benchmark/evaluate.ts",
      "bin/**/*",
      "biome.json",
      "package.json",
      "tsconfig.json"
    ]
  },
  "overrides": [
    {
      "includes": ["scripts/**", "test/**", "benchmark/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "useStrictMode": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
