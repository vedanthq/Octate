#!/usr/bin/env node
/**
 * Octate CLI executable wrapper.
 * Invokes the compiled production CLI entrypoint with full argument and exit code preservation.
 */

import { existsSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
const distCli = resolve(__dirname, '../dist/cli.js');

if (!existsSync(distCli)) {
  process.stderr.write(
    `Error: Octate distribution not found at ${distCli}. Run "npm run build" first.\n`
  );
  process.exit(5);
}

const { main, handleError } = await import(pathToFileURL(distCli).href);

try {
  const exitCode = await main(process.argv.slice(2));
  if (typeof exitCode === 'number' && exitCode !== 0) {
    process.exit(exitCode);
  }
} catch (error) {
  handleError(error);
}
